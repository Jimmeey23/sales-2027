{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["syd1"],
  "functions": {
    "api/index.ts": { "maxDuration": 60, "memory": 1769, "includeFiles": "server/data/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
