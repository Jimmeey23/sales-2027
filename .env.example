# Server-only. Never expose secrets through VITE_ variables.
NODE_ENV=production
PORT=3001
DATABASE_PATH=./p57-data/studio.db
MEMBER_HASH_SALT=replace-with-a-long-random-value
COOKIE_SECURE=true
DIRECT_WORKSPACE=true

# Optional authorised local Checkins CSV. If unset, import:checkins tries the supplied
# Google Sheet export and removes its temporary download. No credential is stored here.
CHECKINS_CSV=

# Optional real AI provider. Without a key, the app clearly reports AI as unavailable
# and continues to support its separately labelled deterministic rules workflows.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_PROVIDER_BASE_URL=https://api.openai.com/v1

# Supabase Postgres connection string (Project Settings → Database → URI). URL-encode special
# characters in the password ($ → %24, @ → %40). Planning data syncs here; omit to stay local-only.
DATABASE_URL=
