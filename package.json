{
  "name": "p57-sales-intelligence-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/dev-clean.mjs",
    "dev": "concurrently -k \"tsx watch server/main.ts\" \"vite --host 0.0.0.0 --open\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/main.ts",
    "seed": "tsx server/seed.ts",
    "import:checkins": "tsx scripts/import-checkins.ts",
    "targets:regenerate": "tsx scripts/regenerate-targets.ts",
    "plan:import": "tsx scripts/import-2027-plan.ts",
    "history:publish": "tsx scripts/publish-history.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "test:e2e": "playwright test",
    "user": "tsx scripts/user.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"api/**/*.ts\" \"e2e/**/*.ts\"",
    "plan:january": "tsx scripts/import-january-offers.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "better-sqlite3": "^12.4.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
